# See https://help.github.com/articles/ignoring-files for more about ignoring files.

/.bundle
/.env

# Logs and temp files
/log/*
/tmp/*
!/log/.keep
!/log/.gitkeep
!/tmp/.keep

# Built assets (yarn build / yarn build:css)
/app/assets/builds/*
!/app/assets/builds/.keep
/public/assets

/node_modules

# Credentials
/config/master.key

# Local database dumps and OS files
*.dump
.DS_Store
