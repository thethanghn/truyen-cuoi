<%= form_with(model: @post, class: 'form-post') do |f| %>
  <% if @post.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(@post.errors.count, "error") %> prohibited this post from being saved:</h2>

      <ul>
      <% @post.errors.full_messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= f.label :body %><br />
    <%= f.hidden_field :body, id: "post_body_input" %>
    <trix-editor input="post_body_input" class="trix-content" style="min-height: 400px"></trix-editor>
  </div>
  <div class="field">
    <%= f.label :published %><br />
    <%= f.check_box :published %>
  </div>
  <div class="actions">
    <%= f.hidden_field :post_type %>
    <%= f.submit %>
  </div>
<% end %>
