<!DOCTYPE html>
<html>
<head>
  <title><%= content_for(:title) || "Truyện Cười" %></title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= stylesheet_link_tag "fuelux", "application", media: "all" %>
  <%= javascript_include_tag "application", "header" %>
</head>
<body>
  <%= render "layouts/header" %>
  <div class="container-fluid">
    <div class="row-fluid clearfix">
      <%= yield %>
    </div>
  </div>
  <%= render "shared/me" %>
  <%= render "layouts/analytics" %>
</body>
</html>
